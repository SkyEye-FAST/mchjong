{
  "schemaVersion": 1,
  "id": "mchjong",
  "version": "${version}",
  "name": "MChjong",
  "description": "Playable, in-world mahjong tables with configurable rules.",
  "authors": [
    "SkyEye_FAST"
  ],
  "breaks": {
    "create": ["<${create_min_version}", ">=7"]
  },
  "license": "Apache-2.0",
  "icon": "assets/mchjong/icon.png",
  "environment": "*",
  "entrypoints": {
    "little_maid_extension": [
      "top.skyeyefast.mchjong.compat.maid.MaidExtension"
    ],
    "main": [
      "top.skyeyefast.mchjong.Mchjong"
    ],
    "client": [
      "top.skyeyefast.mchjong.MchjongClient"
    ],
    "jei_mod_plugin": [
      "top.skyeyefast.mchjong.compat.jei.MahjongJeiPlugin",
      "top.skyeyefast.mchjong.compat.create.CreateWorkshopJei"
    ],
    "emi": [
      "top.skyeyefast.mchjong.compat.emi.MahjongEmiPlugin",
      "top.skyeyefast.mchjong.compat.create.CreateWorkshopEmi"
    ],
    "rei_client": [
      "top.skyeyefast.mchjong.compat.rei.MahjongReiPlugin"
    ]
  },
  "mixins": [
    "mchjong.create.mixins.json",
    "mchjong.data.mixins.json",
    "mchjong.client.mixins.json"
  ],
  "suggests": {
    "create": ">=${create_min_version}",
    "patchouli": "*",
    "ponder": ">=${ponder_version}",
    "jei": ">=${jei_version}",
    "emi": ">=${emi_version}",
    "roughlyenoughitems": ">=${rei_version}",
    "touhou_little_maid": ">=${orihime_version}"
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_min_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  }
}
