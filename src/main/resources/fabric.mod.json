{
  "schemaVersion": 1,
  "id": "mchjong",
  "version": "${version}",
  "name": "MCjhong",
  "description": "A seated, in-world riichi mahjong mod.",
  "authors": [
    "SkyEye_FAST"
  ],
  "license": "Apache-2.0",
  "icon": "assets/mchjong/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "top.skyeyefast.mchjong.Mchjong"
    ],
    "client": [
      "top.skyeyefast.mchjong.MchjongClient"
    ]
  },
  "mixins": [
